# Environnements et dependances re-telechargeables (voir scripts/fetch_dependencies.ps1)
.venv-gpu/
tools/
vendor/
node_modules/
__pycache__/
*.pyc
# Logs et fichiers temporaires de session
*.log
*.err
nohup.out
cf_args.txt
perf/out/
