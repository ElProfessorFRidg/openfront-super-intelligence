runs/**/ckpt_u*.pt
runs/**/ckpt_u*.pt.sha256
runs/**/*.tmp
# Marqueurs de controle d'entrainement
runs/**/STOP
runs/**/PAUSE
.venv/
runs/_notifications.jsonl
